/*.html
  Content-Type: text/html; charset=utf-8
  Cache-Control: no-cache, must-revalidate
  CF-Cache-Tag: v2-livro-utf8

/*.png
  Cache-Control: public, max-age=31536000, immutable

/*.jpg
  Cache-Control: public, max-age=31536000, immutable

/*.svg
  Cache-Control: public, max-age=31536000, immutable

/*.js
  Cache-Control: no-cache, must-revalidate

/*.css
  Cache-Control: no-cache, must-revalidate

/app-bundle.json
  Cache-Control: no-cache, must-revalidate
  Access-Control-Allow-Origin: *

/app-bundle.zip
  Cache-Control: public, max-age=31536000, immutable
